<Window x:Class="Libro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Libro · Contabilidad"
        Width="1280" Height="820"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="MainWindow_KeyDown"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#1C3A30">
                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="#7BE0B4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,1,0,0">
                            <TextBlock Text="Libro" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Contabilidad" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="CompanyLabel" Text="Mi negocio" FontSize="11"
                               Foreground="{StaticResource SidebarMutedBrush}" Margin="0,16,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Style="{StaticResource NavListBox}"
                         SelectionChanged="NavList_SelectionChanged" />

                <Border Grid.Row="2" Background="#173027" CornerRadius="12" Padding="12" Margin="12,8,12,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#2B5A47">
                            <TextBlock x:Name="InitialsLabel" Text="A" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UserNameLabel" Text="Usuario" Foreground="White" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UserRoleLabel" Text="Rol" Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Height="26" Padding="7,0"
                                VerticalAlignment="Center" Margin="0,0,2,0"
                                ToolTip="Atajos de teclado (F1)" Click="ShortcutsButton_Click">
                            <TextBlock Text="F1" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarMutedBrush}" />
                        </Button>
                        <Button Grid.Column="3" Content="&#xE7E8;" Style="{StaticResource IconButton}"
                                Foreground="{StaticResource SidebarMutedBrush}" ToolTip="Cerrar sesión"
                                Click="LogoutButton_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
