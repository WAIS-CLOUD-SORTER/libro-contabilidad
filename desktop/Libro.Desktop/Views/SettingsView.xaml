<UserControl x:Class="Libro.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SettingsNavItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource ElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,26,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Configuración" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Datos del negocio, cuentas, categorías, impuestos y respaldos cifrados." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top">
                <StackPanel>
                    <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SettingsNavItem}"
                             SelectionChanged="SettingsNav_SelectionChanged">
                        <ListBoxItem Content="Negocio e impuestos" Tag="negocio" />
                        <ListBoxItem Content="Cuentas de efectivo" Tag="cuentas" />
                        <ListBoxItem Content="Categorías" Tag="categorias" />
                        <ListBoxItem x:Name="BackupsNavItem" Content="Respaldos" Tag="respaldos" />
                        <ListBoxItem x:Name="SyncNavItem" Content="Ventas por celular" Tag="sync" />
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="CompanyPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Datos del negocio" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Aparecen en facturas y reportes internos."
                                           Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre del negocio" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CompanyNameBox" MaxLength="120" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RFC" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CompanyRfcBox" MaxLength="20" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Régimen fiscal" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RegimenBox" MaxLength="160" />
                                </StackPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="PhoneBox" MaxLength="40" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="EmailBox" MaxLength="160" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="IVA (%)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="IvaRateBox" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AddressBox" MaxLength="300" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Facturación interna" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,14" TextWrapping="Wrap"
                                           Text="Las facturas son documentos internos y no se timbran ante el SAT (No es CFDI)." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Serie" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="SeriesBox" MaxLength="10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Siguiente folio" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NextNumberBox" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Nómina e ISR" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,14" TextWrapping="Wrap"
                                           Text="El IMSS se calcula como porcentaje de las percepciones. Las tarifas de ISR son una referencia editable; confirma con tu contador." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="IMSS (%)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ImssRateBox" HorizontalContentAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button x:Name="ResetIsrButton"
                                                Content="Restaurar tarifas de ISR de referencia"
                                                Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Click="ResetIsr_Click" />
                                    </StackPanel>
                                </Grid>
                                <Expander Header="Tarifas de ISR (JSON avanzado)" Margin="0,14,0,0">
                                    <TextBox x:Name="IsrBox" Height="150" Margin="0,8,0,0"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                             FontSize="10.5" VerticalContentAlignment="Top" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <TextBlock x:Name="CompanyErrorText" Style="{StaticResource ErrorText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button x:Name="SaveCompanyButton" Content="Guardar configuración"
                                    Style="{StaticResource PrimaryButton}" Click="SaveCompany_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AccountsPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,16,20,12">
                                    <StackPanel>
                                        <TextBlock Text="Cuentas de efectivo" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="La cuenta se usa en movimientos, cobros y pagos de nómina."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button x:Name="NewAccountButton" Content="Nueva cuenta"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="NewAccount_Click" />
                                </Grid>
                                <DataGrid x:Name="AccountsGrid" Grid.Row="1" Height="430" RowHeight="48"
                                          ColumnHeaderHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cuenta" Width="*" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Tipo" Width="100" Binding="{Binding TypeLabel}" />
                                        <DataGridTemplateColumn Header="Saldo inicial" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OpeningLabel}" HorizontalAlignment="Right" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Saldo actual" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding BalanceLabel}" HorizontalAlignment="Right"
                                                               FontWeight="SemiBold" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Estado" Width="88"
                                                            Binding="{Binding StatusLabel}" />
                                        <DataGridTemplateColumn x:Name="AccountActionsColumn" Header="" Width="166">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Editar" Style="{StaticResource RowActionButton}"
                                                                Width="56" Tag="{Binding}" Click="EditAccount_Click"
                                                                Margin="0,0,4,0" />
                                                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource RowActionButton}"
                                                                Width="90" Tag="{Binding}" Click="ToggleAccount_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CategoriesPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,16,20,12">
                                    <StackPanel>
                                        <TextBlock Text="Categorías" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Clasifican ingresos y gastos. Puedes archivar sin borrar historial."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <CheckBox x:Name="ShowArchivedCategories" Content="Incluir archivadas"
                                                  Margin="0,0,12,0" Click="ShowArchived_Click" />
                                        <Button x:Name="NewCategoryButton" Content="Nueva categoría"
                                                Style="{StaticResource PrimaryButton}" Click="NewCategory_Click" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="CategoriesGrid" Grid.Row="1" Height="430" RowHeight="44"
                                          ColumnHeaderHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Categoría" Width="*" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Tipo" Width="100" Binding="{Binding KindLabel}" />
                                        <DataGridTextColumn Header="Estado" Width="100" Binding="{Binding StatusLabel}" />
                                        <DataGridTemplateColumn x:Name="CategoryActionsColumn" Header="" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Editar" Style="{StaticResource RowActionButton}"
                                                                Width="56" Tag="{Binding}" Click="EditCategory_Click"
                                                                Margin="0,0,4,0" />
                                                        <Button Content="{Binding ToggleLabel}" Style="{StaticResource RowActionButton}"
                                                                Width="92" Tag="{Binding}" Click="ToggleCategory_Click"
                                                                Margin="0,0,4,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="BackupsPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Respaldos cifrados" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,14" TextWrapping="Wrap"
                                           Text="Los respaldos son copias SQLCipher protegidas con la misma llave de Windows. Solo este usuario de Windows puede restaurarlas." />
                                <Border Background="{StaticResource ElevatedBrush}" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="Carpeta de respaldos" Style="{StaticResource FieldLabel}" />
                                        <TextBlock x:Name="BackupDirectoryText" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="CreateBackupButton" Content="Crear respaldo ahora"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                            Click="CreateBackup_Click" />
                                    <Button x:Name="SaveBackupButton" Content="Guardar copia en…"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                            Click="SaveBackup_Click" />
                                    <Button Content="Abrir carpeta" Style="{StaticResource GhostButton}"
                                            Click="OpenBackupFolder_Click" />
                                </StackPanel>
                                <TextBlock x:Name="BackupStatusText" Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,16,20,10">
                                    <TextBlock Text="Respaldos disponibles" Style="{StaticResource SectionTitle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="RestoreFileButton" Content="Restaurar desde archivo…"
                                                Style="{StaticResource GhostButton}" Click="RestoreFile_Click" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="BackupsGrid" Grid.Row="1" Height="260" RowHeight="44"
                                          ColumnHeaderHeight="36">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Archivo" Width="*" Binding="{Binding FileName}" />
                                        <DataGridTextColumn Header="Fecha" Width="150" Binding="{Binding DateLabel}" />
                                        <DataGridTextColumn Header="Tamaño" Width="100" Binding="{Binding SizeLabel}" />
                                        <DataGridTemplateColumn x:Name="RestoreActionsColumn" Header="" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Restaurar" Style="{StaticResource GhostButton}"
                                                            Width="86" Tag="{Binding}" Click="RestoreBackup_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SyncPanel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ventas desde el teléfono" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Activa un servidor local para que un teléfono en la misma red Wi-Fi registre ventas sobre esta misma base. Solo escucha en direcciones privadas y cada teléfono se empareja con el PIN de abajo. La computadora debe estar encendida, con Libro abierto y la sesión iniciada." />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <CheckBox x:Name="SyncEnabledCheck" Content="Permitir ventas desde el teléfono"
                                              VerticalAlignment="Center" />
                                    <Button x:Name="SyncApplyButton" Content="Aplicar"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="16,0,0,0" Click="SyncApply_Click" />
                                </StackPanel>

                                <TextBlock Text="Dirección para el teléfono" Style="{StaticResource FieldLabel}"
                                           Margin="0,18,0,0" />
                                <TextBox x:Name="SyncUrlBox" IsReadOnly="True" />

                                <TextBlock Text="PIN de emparejamiento" Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <TextBox x:Name="SyncPinBox" IsReadOnly="True" FontSize="22"
                                         FontWeight="SemiBold" HorizontalContentAlignment="Center" />

                                <TextBlock x:Name="SyncStatusText" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock x:Name="SyncErrorText" Style="{StaticResource ErrorText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Teléfonos emparejados" Style="{StaticResource SectionTitle}" />
                                <ItemsControl x:Name="SyncDevicesList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="SyncRevokeButton" Content="Quitar todos los teléfonos"
                                        Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Click="SyncRevoke_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Cobro con terminal Mercado Pago" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Pega el Access Token de producción de tu aplicación en Mercado Pago Developers. Se guarda cifrado con la cuenta de Windows de este equipo (DPAPI) y no se escribe en la bitácora. Sin estos datos, Libro usa una terminal simulada que no cobra nada." />

                                <TextBlock Text="Access Token" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                                <PasswordBox x:Name="MpTokenBox" Height="38" Padding="10,8" VerticalContentAlignment="Center" />

                                <TextBlock Text="ID del terminal (device_id)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                                <TextBox x:Name="MpDeviceBox" />
                                <ComboBox x:Name="MpDeviceCombo" Margin="0,8,0,0" DisplayMemberPath="."
                                          SelectionChanged="MpDeviceCombo_SelectionChanged" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="MpTestButton" Content="Probar credenciales"
                                            Style="{StaticResource SecondaryButton}" Click="MpTest_Click" />
                                    <Button x:Name="MpSaveButton" Content="Guardar"
                                            Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="MpSave_Click" />
                                    <Button x:Name="MpForgetButton" Content="Olvidar"
                                            Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="MpForget_Click" />
                                </StackPanel>

                                <TextBlock x:Name="MpStatusText" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock x:Name="MpErrorText" Style="{StaticResource ErrorText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
