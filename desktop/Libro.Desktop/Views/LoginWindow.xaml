<Window x:Class="Libro.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Libro · Entrar"
        Width="920" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.95*" />
            <ColumnDefinition Width="1.05*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="46">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#1C3A30">
                            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="#7BE0B4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,2,0,0">
                            <TextBlock Text="Libro" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Contabilidad para tu negocio" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Todo tu negocio, en orden." FontSize="30" FontWeight="SemiBold"
                               Foreground="White" TextWrapping="Wrap" Margin="0,62,0,0" LineHeight="38" />
                    <TextBlock Text="Consulta tus números, registra movimientos y toma decisiones con información clara."
                               FontSize="14" Foreground="{StaticResource SidebarMutedBrush}" TextWrapping="Wrap"
                               Margin="0,14,0,0" LineHeight="22" />
                </StackPanel>

                <Border VerticalAlignment="Bottom" Background="#173027" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="CompanyNameText" Text="Mi negocio" Foreground="White"
                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Los datos están cifrados y protegidos por tu cuenta de Windows."
                                   Foreground="{StaticResource SidebarMutedBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="64,50,64,40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Entra a tu contabilidad" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Usa la cuenta que creaste al configurar el sistema."
                           Style="{StaticResource PageSubtitle}" Margin="0,8,0,30" />

                <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EmailBox" Margin="0,0,0,16" MaxLength="160" />

                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" MaxLength="200" />

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,16,0,0"
                           Visibility="Collapsed" />

                <Button x:Name="LoginButton" Content="Entrar" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,26,0,0" Click="LoginButton_Click" IsDefault="True" />

                <TextBlock Text="¿Olvidaste tu contraseña? Pídele al administrador que la restablezca desde Usuarios."
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,18,0,0"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
