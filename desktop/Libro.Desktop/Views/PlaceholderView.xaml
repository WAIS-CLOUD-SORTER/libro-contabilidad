<UserControl x:Class="Libro.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,34">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}" Margin="0,26,0,0" Padding="28">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,22">
                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="34"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Módulo en construcción" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Esta pantalla ya forma parte de la aplicación nativa y se está conectando a su módulo contable."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="460" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
