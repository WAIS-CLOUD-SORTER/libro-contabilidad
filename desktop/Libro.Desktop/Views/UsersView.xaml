<UserControl x:Class="Libro.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Libro.Desktop.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ModuleTabItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource ElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="34,26,34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Usuarios y auditoría" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Cuentas, roles y registro de cambios. Solo los administradores pueden modificar usuarios." />
        </StackPanel>

        <ListBox x:Name="TabList" Grid.Row="1" Margin="0,16,0,14" Background="Transparent"
                 BorderThickness="0" SelectionChanged="TabList_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBoxItem x:Name="UsersTab" Content="Usuarios" Tag="usuarios"
                         Style="{StaticResource ModuleTabItem}" />
            <ListBoxItem x:Name="AuditTab" Content="Auditoría" Tag="auditoria"
                         Style="{StaticResource ModuleTabItem}" />
        </ListBox>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="UsersPanel" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NewUserButton" Content="Nuevo usuario"
                                    Style="{StaticResource PrimaryButton}" Click="NewUser_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RoleSummaryText" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Usuarios" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TotalValue" Text="0" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="Registrados" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Activos" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="ActiveValue" Text="0" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="Pueden iniciar sesión" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Administradores" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="AdminValue" Text="0" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="Acceso total" Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                        <DataGrid x:Name="UsersGrid" Height="420" RowHeight="58" ColumnHeaderHeight="36">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Usuario" Width="1.5*" MinWidth="210">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Email}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Rol" Width="150" Binding="{Binding RoleLabel}" />
                                <DataGridTextColumn Header="Estado" Width="90" Binding="{Binding StatusLabel}" />
                                <DataGridTextColumn Header="Último acceso" Width="160"
                                                    Binding="{Binding LastLoginLabel}" />
                                <DataGridTemplateColumn x:Name="UserActionsColumn" Header="" Width="236">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Editar" Style="{StaticResource RowActionButton}"
                                                        Width="54" Tag="{Binding}" Click="EditUser_Click"
                                                        Margin="0,0,4,0" />
                                                <Button Content="Contraseña" Style="{StaticResource RowActionButton}"
                                                        Width="84" Tag="{Binding}" Click="ResetPassword_Click"
                                                        Margin="0,0,4,0" />
                                                <Button Content="Activar" Style="{StaticResource RowActionButton}"
                                                        Width="62" Tag="{Binding}" Click="ToggleUser_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AuditPanel" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Buscar" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AuditSearchBox" ToolTip="Usuario, detalle o entidad" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Acción" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="AuditActionBox" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Entidad" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="AuditEntityBox" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" />
                                    <controls:DateField x:Name="AuditFromField" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" />
                                    <controls:DateField x:Name="AuditToField" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Buscar" Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Bottom" Margin="0,0,8,0" Click="AuditFilter_Click" />
                                <Button Grid.Column="4" Content="Limpiar" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom" Click="AuditClear_Click" />
                                <TextBlock x:Name="AuditCountText" Grid.Column="5" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Style="{StaticResource MutedText}"
                                           Margin="12,0,2,10" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                        <DataGrid x:Name="AuditGrid" Height="500" RowHeight="46" ColumnHeaderHeight="36">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Width="150" Binding="{Binding CreatedLabel}" />
                                <DataGridTextColumn Header="Usuario" Width="150" Binding="{Binding UserLabel}" />
                                <DataGridTextColumn Header="Acción" Width="130" Binding="{Binding ActionLabel}" />
                                <DataGridTextColumn Header="Entidad" Width="120" Binding="{Binding EntityLabel}" />
                                <DataGridTextColumn Header="Detalle" Width="*" Binding="{Binding Detail}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
