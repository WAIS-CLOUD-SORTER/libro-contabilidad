<Window x:Class="Libro.Desktop.Views.Dialogs.PayrollPeriodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva nómina · Libro"
        Width="520" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Nueva nómina" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Se crearán los conceptos de todos los empleados activos en el periodo." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,18,26,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Año" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="YearBox" MaxLength="4" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mes" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="MonthBox" SelectionChanged="Period_Changed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipo de periodo" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TypeBox" SelectionChanged="Period_Changed">
                                <ComboBoxItem Content="Mensual" Tag="mensual" />
                                <ComboBoxItem Content="Quincenal" Tag="quincenal" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quincena" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="QuincenaBox" SelectionChanged="Period_Changed">
                                <ComboBoxItem Content="Primera" Tag="1" />
                                <ComboBoxItem Content="Segunda" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="10" Padding="14,12"
                            Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Periodo a calcular" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="RangeText" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="EmployeesText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Crear nómina" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
