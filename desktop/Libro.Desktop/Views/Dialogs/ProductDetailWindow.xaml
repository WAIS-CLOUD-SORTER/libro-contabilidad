<Window x:Class="Libro.Desktop.Views.Dialogs.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Libro.Desktop.Controls"
        Title="Producto · Libro"
        Width="1160" Height="880"
        MinWidth="1000" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Producto" Style="{StaticResource PageTitle}" FontSize="25" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditButton" Content="Editar" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Edit_Click" />
                    <Button Content="Cerrar" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Stock actual" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="StockValue" Text="—" Style="{StaticResource MetricValue}" />
                                <TextBlock x:Name="MinStockHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Costo promedio" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="CostValue" Text="$0.00" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="Sin IVA" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Valor" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="InventoryValue" Text="$0.00" Style="{StaticResource MetricValue}" />
                                <TextBlock Text="Stock × costo" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource CardFlat}">
                            <StackPanel>
                                <TextBlock Text="Margen" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="MarginValue" Text="0%" Style="{StaticResource MetricValue}" />
                                <TextBlock x:Name="PriceHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Ficha" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SKU" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="SkuText" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="UnitText" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="IVA" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="IvaText" FontSize="13" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="DescriptionText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,12,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                        <StackPanel>
                            <Border Padding="18,15,18,10">
                                <Grid>
                                    <TextBlock Text="Movimientos de inventario" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="MovementsHint" HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                            </Border>
                            <DataGrid x:Name="MovementsGrid" Height="330" RowHeight="42" ColumnHeaderHeight="34"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Width="86"
                                                        Binding="{Binding Date, Converter={StaticResource Date}}" />
                                    <DataGridTemplateColumn Header="Tipo" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Cantidad" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="qtyText" Text="{Binding QtyLabel}"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Qty}" Value="0">
                                                        <Setter TargetName="qtyText" Property="Foreground"
                                                                Value="{StaticResource MutedBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Costo" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitCostCents, Converter={StaticResource Money}}"
                                                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Motivo" Width="*" Binding="{Binding Reason}" />
                                    <DataGridTextColumn Header="Cuenta" Width="88" Binding="{Binding AccountName}" />
                                    <DataGridTextColumn Header="Registró" Width="110" Binding="{Binding UserName}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoMovementsText" Text="Aún no hay movimientos registrados."
                                       Style="{StaticResource MutedText}" Margin="18,0,18,16" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border x:Name="MovementPanel" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Registrar movimiento" Style="{StaticResource SectionTitle}" />
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="TypeBox" SelectedIndex="0" SelectionChanged="Type_Changed">
                                    <ComboBoxItem Content="Entrada" Tag="entrada" />
                                    <ComboBoxItem Content="Salida" Tag="salida" />
                                    <ComboBoxItem Content="Ajuste de stock" Tag="ajuste" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}" />
                                <controls:DateField x:Name="MovementDate" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock x:Name="QtyLabel" Text="Cantidad" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="QtyBox" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <Grid Margin="0,8,0,0">
                                <TextBlock x:Name="ResultHint" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                            </Grid>

                            <StackPanel x:Name="PurchasePanel" Margin="0,12,0,0">
                                <TextBlock Text="Costo unitario" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CostBox" HorizontalContentAlignment="Right" />
                                <TextBlock Text="¿Pagaste con una cuenta?" Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <ComboBox x:Name="AccountBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
                                <TextBlock Text="IVA de la compra" Style="{StaticResource FieldLabel}"
                                           Margin="0,12,0,0" />
                                <ComboBox x:Name="IvaBox" DisplayMemberPath="Label" SelectedValuePath="Rate" />
                            </StackPanel>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReasonBox" MaxLength="300" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Referencia" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReferenceBox" MaxLength="120" />
                            </StackPanel>

                            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,10,0,0" />
                            <Button x:Name="SaveButton" Content="Registrar entrada"
                                    Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                                    Click="SaveMovement_Click" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                       Text="Las entradas recalculan el costo promedio. Si eliges una cuenta se crea el gasto con IVA acreditable." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NoStockPanel" Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Sin control de stock" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Este producto o servicio no descuenta inventario. Actívalo desde Editar si quieres controlar existencias." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>

