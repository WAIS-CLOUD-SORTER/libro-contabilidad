<Window x:Class="Libro.Desktop.Views.Dialogs.PayrollPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Libro.Desktop.Controls"
        Title="Pagar nómina · Libro"
        Width="540" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Pagar nómina" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,18,26,18">
            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Neto total del periodo" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="NetText" Text="$0.00" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="EmployeesText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Cuenta de pago" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AccountBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Fecha de pago" Style="{StaticResource FieldLabel}" />
                        <controls:DateField x:Name="PaymentDate" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                               Text="Se registrará un gasto de nómina sin IVA, vinculado a este periodo." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button x:Name="SaveButton" Content="Registrar pago" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
