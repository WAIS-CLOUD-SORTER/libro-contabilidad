<Window x:Class="Libro.Desktop.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Producto · Libro"
        Width="760" Height="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nuevo producto" Style="{StaticResource PageTitle}"
                           FontSize="24" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                           Text="El stock se controla con movimientos de inventario." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,18,26,18">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Datos generales" Style="{StaticResource SectionTitle}" />
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" MaxLength="160" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SKU" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SkuBox" MaxLength="80" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unidad" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="UnitBox" MaxLength="40" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Precios e impuestos" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio de venta" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PriceBox" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Costo unitario" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CostBox" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="IVA" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="IvaBox" DisplayMemberPath="Label" SelectedValuePath="Rate" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                   Text="Los importes se capturan sin IVA. El costo es la base del costo promedio." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Existencias" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="TrackStockBox" Content="Controlar inventario y descontar stock al facturar"
                                  Margin="0,14,0,0" IsChecked="True" Checked="TrackStock_Changed"
                                  Unchecked="TrackStock_Changed" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stock mínimo" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="MinStockBox" HorizontalContentAlignment="Right" Text="0" />
                            </StackPanel>
                            <StackPanel x:Name="InitialStockPanel" Grid.Column="2">
                                <TextBlock Text="Stock inicial" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="InitialStockBox" HorizontalContentAlignment="Right" Text="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Descripción" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="DescriptionBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="10,8" MaxLength="1000"
                                 Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                            Margin="0,0,10,0" />
                    <Button Content="Guardar producto" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
