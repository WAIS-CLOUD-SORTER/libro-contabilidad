<Window x:Class="Libro.Desktop.Views.Dialogs.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuenta · Libro"
        Width="520" Height="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nueva cuenta" Style="{StaticResource PageTitle}"
                           FontSize="24" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Cuentas de efectivo o banco para cobros y pagos." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,18,26,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" MaxLength="120" />
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TypeBox">
                                <ComboBoxItem Content="Efectivo" Tag="efectivo" />
                                <ComboBoxItem Content="Banco" Tag="banco" />
                                <ComboBoxItem Content="Tarjeta" Tag="tarjeta" />
                                <ComboBoxItem Content="Otro" Tag="otro" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Saldo inicial" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="OpeningBox" HorizontalContentAlignment="Right" />
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ActiveBox" Content="Cuenta activa" IsChecked="True" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="El saldo inicial se suma al saldo calculado con movimientos y cobros." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Guardar cuenta" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
