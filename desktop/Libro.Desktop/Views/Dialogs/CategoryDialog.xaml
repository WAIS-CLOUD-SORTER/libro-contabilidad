<Window x:Class="Libro.Desktop.Views.Dialogs.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categoría · Libro"
        Width="500" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nueva categoría" Style="{StaticResource PageTitle}"
                           FontSize="24" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Clasifica ingresos y gastos en movimientos y reportes." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,18,26,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" MaxLength="120" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="KindBox">
                            <ComboBoxItem Content="Gasto" Tag="gasto" />
                            <ComboBoxItem Content="Ingreso" Tag="ingreso" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ArchivedBox" Content="Archivada (oculta en movimientos nuevos)"
                              Margin="0,16,0,0" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Guardar categoría" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
