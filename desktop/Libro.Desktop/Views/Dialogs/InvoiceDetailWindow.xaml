<Window x:Class="Libro.Desktop.Views.Dialogs.InvoiceDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factura · Libro"
        Width="1040" Height="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="Factura" Style="{StaticResource PageTitle}" FontSize="25" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cerrar" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Click="Close_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="CLIENTE" Style="{StaticResource MetricLabel}" />
                                    <TextBlock x:Name="ClientName" Text="—" FontSize="19" FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                    <TextBlock x:Name="ClientRfc" Text="—" Style="{StaticResource MutedText}" />
                                </StackPanel>
                                <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="99" Padding="10,4" Background="{StaticResource WarnSoftBrush}">
                                    <TextBlock x:Name="StatusText" Text="Borrador" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Emisión" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="IssueDate" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Vencimiento" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DueDateText" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Condiciones" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="TermsText" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Registró" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="CreatedByText" FontSize="13" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CancelledPanel" Style="{StaticResource Card}" Margin="0,14,0,0"
                            Background="{StaticResource DangerSoftBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Factura cancelada" Foreground="{StaticResource DangerBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CancelledReason" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                        <StackPanel>
                            <Border Padding="18,15,18,10">
                                <Grid>
                                    <TextBlock Text="Conceptos" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ItemsHint" HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                            </Border>
                            <DataGrid x:Name="ItemsGrid" Height="210" RowHeight="38" ColumnHeaderHeight="34"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Descripción" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sku}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Cant." Width="66"
                                                        Binding="{Binding Qty, StringFormat={}{0:#,0.###}}" />
                                    <DataGridTemplateColumn Header="Precio" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitPriceCents, Converter={StaticResource Money}}"
                                                           HorizontalAlignment="Right" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="IVA" Width="62"
                                                        Binding="{Binding IvaRate, Converter={StaticResource Percent}}" />
                                    <DataGridTemplateColumn Header="Importe" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SubtotalCents, Converter={StaticResource Money}}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                        <StackPanel>
                            <Border Padding="18,15,18,10">
                                <Grid>
                                    <TextBlock Text="Pagos recibidos" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="PaymentsHint" HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" />
                                </Grid>
                            </Border>
                            <DataGrid x:Name="PaymentsGrid" Height="170" RowHeight="38" ColumnHeaderHeight="34"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Width="98"
                                                        Binding="{Binding Date, Converter={StaticResource Date}}" />
                                    <DataGridTextColumn Header="Método" Width="112" Binding="{Binding Method}" />
                                    <DataGridTextColumn Header="Cuenta" Width="130" Binding="{Binding AccountName}" />
                                    <DataGridTextColumn Header="Referencia" Width="*" Binding="{Binding Reference}" />
                                    <DataGridTemplateColumn Header="Monto" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AmountCents, Converter={StaticResource Money}}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                        Width="26" Height="26" Foreground="{StaticResource DangerBrush}"
                                                        ToolTip="Eliminar pago" Tag="{Binding}" Click="DeletePayment_Click" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoPaymentsText" Text="Sin pagos registrados."
                                       Style="{StaticResource MutedText}" Margin="18,0,18,16" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NotesPanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Notas" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="NotesText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Totales" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="Subtotal" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="SubtotalValue" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="IVA" Style="{StaticResource MutedText}" />
                                <TextBlock x:Name="IvaValue" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Total" FontWeight="SemiBold" />
                                <TextBlock x:Name="TotalValue" HorizontalAlignment="Right" FontSize="17"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Pagado" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="PaidValue" HorizontalAlignment="Right"
                                           Foreground="{StaticResource SuccessBrush}" />
                            </Grid>
                            <Border Background="{StaticResource ElevatedBrush}" CornerRadius="8" Padding="10,8"
                                    Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="Saldo" FontWeight="SemiBold" />
                                    <TextBlock x:Name="BalanceValue" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                                       Text="Documento interno de control. No es un CFDI ni comprobante fiscal." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="DraftPanel" Style="{StaticResource Card}" Margin="0,14,0,0"
                            Background="{StaticResource WarnSoftBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Borrador" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                       Text="Al emitir se asigna folio y se descuenta el inventario de los productos incluidos." />
                            <Button Content="Emitir factura" Style="{StaticResource PrimaryButton}" Click="Emit_Click" />
                            <Button Content="Editar borrador" Style="{StaticResource SecondaryButton}"
                                    Margin="0,8,0,0" Click="Edit_Click" />
                            <Button Content="Eliminar borrador" Style="{StaticResource GhostButton}"
                                    Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                                    Click="DeleteDraft_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PaymentPanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Cobranza" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="OutstandingHint" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                            <Button Content="Registrar pago" Style="{StaticResource PrimaryButton}"
                                    Click="RegisterPayment_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="CancelPanel" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Cancelación" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                                       Text="Se repondrá el inventario vendido. No se puede deshacer." />
                            <Button Content="Cancelar factura" Style="{StaticResource DangerButton}"
                                    Click="CancelInvoice_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PaidNote" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Text="Para cancelar esta factura, primero elimina los pagos registrados." />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
