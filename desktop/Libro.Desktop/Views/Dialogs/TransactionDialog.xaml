<Window x:Class="Libro.Desktop.Views.Dialogs.TransactionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Libro.Desktop.Controls"
        Title="Movimiento · Libro"
        Width="720" Height="900"
        MinWidth="680" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="28,22">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nuevo movimiento" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                           Text="Registra un gasto o un ingreso que no pasa por facturación." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,20">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tipo de movimiento" Style="{StaticResource SectionTitle}" />
                        <Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="3"
                                HorizontalAlignment="Left" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="IncomeRadio" Style="{StaticResource SegmentRadio}"
                                             Content="Ingreso" Checked="Type_Checked" />
                                <RadioButton x:Name="ExpenseRadio" Style="{StaticResource SegmentRadio}"
                                             Content="Gasto" Checked="Type_Checked" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Fecha" Style="{StaticResource FieldLabel}" />
                                <controls:DateField x:Name="MovementDate" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <TextBlock Text="Descripción" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DescriptionBox" MaxLength="300" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Contacto" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ContactBox" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Cuenta de efectivo" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="AccountBox" DisplayMemberPath="Name"
                                          SelectedValuePath="Id" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,14,0,0">
                                <TextBlock Text="Método" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="MethodBox" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Referencia" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReferenceBox" MaxLength="120" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Importe" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Subtotal (sin IVA)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SubtotalBox" HorizontalContentAlignment="Right"
                                         FontSize="17" FontWeight="SemiBold" TextChanged="SubtotalBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="IVA" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="IvaBox" DisplayMemberPath="Label"
                                          SelectedValuePath="Rate" SelectionChanged="IvaBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource ElevatedBrush}" CornerRadius="9" Padding="14"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="IVA" Style="{StaticResource MutedText}" />
                                    <TextBlock x:Name="IvaValue" Text="$0.00" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Total" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TotalValue" Text="$0.00" HorizontalAlignment="Right"
                                               FontSize="18" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource MutedText}" Margin="0,14,0,0"
                                   Text="Las ventas que emites con factura se capturan en Facturas. Usa este formulario para gastos e ingresos no facturados." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}"
                           VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="Guardar movimiento"
                            Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
