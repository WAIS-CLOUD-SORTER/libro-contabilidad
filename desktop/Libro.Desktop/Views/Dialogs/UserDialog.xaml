<Window x:Class="Libro.Desktop.Views.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuario · Libro"
        Width="560" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Nuevo usuario" Style="{StaticResource PageTitle}"
                           FontSize="24" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                           Text="Define el acceso y el rol dentro de Libro." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,18,26,18">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NameBox" MaxLength="120" />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Correo" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EmailBox" MaxLength="160" />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Rol" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RoleBox" SelectionChanged="RoleBox_SelectionChanged">
                                <ComboBoxItem Content="Administrador" Tag="admin" />
                                <ComboBoxItem Content="Contador" Tag="contador" />
                                <ComboBoxItem Content="Capturista" Tag="capturista" />
                                <ComboBoxItem Content="Consulta" Tag="consulta" />
                            </ComboBox>
                            <TextBlock x:Name="RoleHintText" Style="{StaticResource MutedText}" Margin="0,5,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="ActiveBox" Content="Usuario activo" IsChecked="True" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="PasswordPanel" Style="{StaticResource Card}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Contraseña inicial" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,12"
                                   Text="Mínimo 8 caracteres. El usuario puede cambiarla después." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="PasswordBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Confirmar" Style="{StaticResource FieldLabel}" />
                                <PasswordBox x:Name="ConfirmBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Guardar usuario" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
