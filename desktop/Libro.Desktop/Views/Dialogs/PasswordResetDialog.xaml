<Window x:Class="Libro.Desktop.Views.Dialogs.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restablecer contraseña · Libro"
        Width="500" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Restablecer contraseña" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="26,18,26,18">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="Nueva contraseña" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="PasswordBox" />
                    </StackPanel>
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ConfirmBox" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0"
                               Text="Mínimo 8 caracteres. Compártela por un medio seguro." />
                </StackPanel>
            </Border>
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Restablecer" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
