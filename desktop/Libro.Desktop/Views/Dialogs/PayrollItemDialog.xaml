<Window x:Class="Libro.Desktop.Views.Dialogs.PayrollItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Concepto de nómina · Libro"
        Width="660" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <StackPanel>
                <TextBlock x:Name="NameText" Text="Concepto" Style="{StaticResource PageTitle}" FontSize="23" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="26,18,26,18">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Percepciones" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Días" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DaysBox" HorizontalContentAlignment="Right" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sueldo base" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="BaseBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Percepciones extra" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ExtraBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Deducciones" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ISR" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="IsrBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="IMSS" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ImssBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Infonavit" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="InfonavitBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Otras deducciones" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OtherBox" HorizontalContentAlignment="Right" TextChanged="Amount_Changed" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Notas" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NotesBox" MaxLength="300" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="18,14" Margin="0,14,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Neto a pagar" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="NetText" Text="$0.00" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock Text="Percepciones menos deducciones" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="26,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True"
                        Margin="0,0,10,0" />
                <Button Content="Guardar concepto" Style="{StaticResource PrimaryButton}"
                        IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
