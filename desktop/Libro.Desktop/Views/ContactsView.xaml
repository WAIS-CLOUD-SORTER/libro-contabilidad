<UserControl x:Class="Libro.Desktop.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Contactos" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Clientes y proveedores con su RFC, datos de contacto y saldo pendiente." />
                </StackPanel>
                <Button x:Name="NewButton" Grid.Column="1" Content="Nuevo contacto"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="New_Click" />
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Clientes" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ClientCount" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Activos" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Proveedores" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ProviderCount" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Activos" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Por cobrar" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ReceivableValue" Text="$0.00" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Facturas emitidas" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Archivados" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ArchivedCount" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Fuera de la lista" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Buscar" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" ToolTip="Nombre, RFC o correo" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Tipo" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeFilter" SelectedIndex="0">
                            <ComboBoxItem Content="Todos" Tag="" />
                            <ComboBoxItem Content="Clientes" Tag="cliente" />
                            <ComboBoxItem Content="Proveedores" Tag="proveedor" />
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ArchivedCheck" Grid.Column="2" Content="Incluir archivados"
                              VerticalAlignment="Bottom" Margin="0,0,14,10" />
                    <Button Grid.Column="3" Content="Filtrar" Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Bottom" Margin="0,0,8,0" Click="Filter_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <DataGrid x:Name="ContactsGrid" Height="450" RowHeight="54" ColumnHeaderHeight="36"
                                  MouseDoubleClick="ContactsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nombre" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tipo" Width="112">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="typePill" Style="{StaticResource Pill}"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock x:Name="typeText"
                                                           Text="{Binding Type, Converter={StaticResource StatusLabel}}"
                                                           Foreground="{StaticResource AccentStrongBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="proveedor">
                                                    <Setter TargetName="typePill" Property="Background"
                                                            Value="{StaticResource InfoSoftBrush}" />
                                                    <Setter TargetName="typeText" Property="Foreground"
                                                            Value="{StaticResource InfoBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="ambos">
                                                    <Setter TargetName="typePill" Property="Background"
                                                            Value="{StaticResource WarnSoftBrush}" />
                                                    <Setter TargetName="typeText" Property="Foreground"
                                                            Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="RFC" Width="105" Binding="{Binding Rfc}" />
                                <DataGridTemplateColumn Header="Contacto" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Email}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Phone}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Por cobrar" Width="102">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="balanceText"
                                                       Text="{Binding ReceivableCents, Converter={StaticResource Money}}"
                                                       Foreground="{StaticResource AccentStrongBrush}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ReceivableCents}" Value="0">
                                                    <Setter TargetName="balanceText" Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                    <Setter TargetName="balanceText" Property="FontWeight"
                                                            Value="Normal" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="86">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="statusPill" Style="{StaticResource Pill}"
                                                    Background="{StaticResource SuccessSoftBrush}">
                                                <TextBlock x:Name="statusText" Text="Activo"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Archived}" Value="1">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource ElevatedBrush}" />
                                                    <Setter TargetName="statusText" Property="Text" Value="Archivado" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="156">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Editar" Style="{StaticResource SmallButton}"
                                                        Width="66" Tag="{Binding}" Click="Edit_Click" />
                                                <Button x:Name="ArchiveButton" Content="Archivar"
                                                        Style="{StaticResource SmallButton}" Width="78"
                                                        Margin="6,0,0,0" Tag="{Binding}" Click="Archive_Click" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Archived}" Value="1">
                                                    <Setter TargetName="ArchiveButton" Property="Content" Value="Reactivar" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,52,0,64">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sin contactos" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Agrega clientes para facturar y proveedores para tus gastos."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <Button x:Name="EmptyNewButton" Content="Nuevo contacto"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                    Margin="0,14,0,0" Click="New_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Padding="16,11">
                        <TextBlock x:Name="CountText" Text="0 contactos" Style="{StaticResource MutedText}" />
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
