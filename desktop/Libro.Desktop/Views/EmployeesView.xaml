<UserControl x:Class="Libro.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Empleados" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Plantilla, datos fiscales y sueldos para el cálculo de la nómina." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewButton" Content="Nuevo empleado" Style="{StaticResource PrimaryButton}"
                            Click="New_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Empleados activos" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ActiveValue" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="En plantilla" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Nómina mensual" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="PayrollValue" Text="$0.00" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Sueldos base" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Inactivos" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="InactiveValue" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Historial" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Buscar" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" ToolTip="Nombre, puesto o RFC" KeyDown="SearchBox_KeyDown" />
                    </StackPanel>
                    <CheckBox x:Name="InactiveBox" Grid.Column="1" Content="Incluir inactivos"
                              VerticalAlignment="Bottom" Margin="8,0,16,10" />
                    <Button Grid.Column="2" Content="Filtrar" Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Bottom" Margin="0,0,8,0" Click="Filter_Click" />
                    <Button Grid.Column="3" Content="Limpiar" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Bottom" Click="Clear_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <DataGrid x:Name="EmployeesGrid" Height="410" RowHeight="56" ColumnHeaderHeight="36"
                                  MouseDoubleClick="EmployeesGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Empleado" Width="1.6*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{StaticResource AccentSoftBrush}" Margin="0,0,9,0">
                                                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Rfc}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Puesto" Width="1.1*" MinWidth="90"
                                                    Binding="{Binding Position}" />
                                <DataGridTextColumn Header="Departamento" Width="0.9*" MinWidth="80"
                                                    Binding="{Binding Department}" />
                                <DataGridTemplateColumn Header="Ingreso" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartDate, Converter={StaticResource Date}}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sueldo" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SalaryCents, Converter={StaticResource Money}}"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="statusPill" CornerRadius="99" Padding="9,3"
                                                    Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="statusText" Text="{Binding StatusLabel}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="inactivo">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource ElevatedBrush}" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="WriteActionsColumn" Header="" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Editar" Style="{StaticResource RowActionButton}"
                                                        Width="56" Tag="{Binding}" Click="Edit_Click" Margin="0,0,4,0" />
                                                <Button Content="Baja" Style="{StaticResource RowActionButton}"
                                                        Width="50" Tag="{Binding}" Click="Toggle_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel x:Name="EmptyPanel" Grid.Row="1" Margin="0,40,0,46"
                                Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="Sin empleados registrados" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Agrega a tu primer empleado para comenzar a calcular nómina."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,16"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="EmptyNewButton" Content="Nuevo empleado"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                Click="New_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" Margin="2,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
