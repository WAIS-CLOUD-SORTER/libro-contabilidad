<UserControl x:Class="Libro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,26,34,34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Inventario" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Productos, existencias y costo promedio. El stock se mueve con entradas, salidas y ajustes." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Exportar CSV" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="Export_Click" />
                    <Button x:Name="NewButton" Content="Nuevo producto" Style="{StaticResource PrimaryButton}"
                            Click="New_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Productos activos" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="ProductCountValue" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="En catálogo" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Valor del inventario" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="InventoryValue" Text="$0.00" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Stock × costo promedio" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Bajo stock" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="LowStockValue" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="En o bajo el mínimo" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource CardFlat}">
                    <StackPanel>
                        <TextBlock Text="Agotados" Style="{StaticResource MetricLabel}" />
                        <TextBlock x:Name="OutOfStockValue" Text="0" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Sin existencias" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Buscar" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" ToolTip="Nombre o SKU" KeyDown="SearchBox_KeyDown" />
                    </StackPanel>
                    <CheckBox x:Name="LowOnlyBox" Grid.Column="1" Content="Solo bajo stock" VerticalAlignment="Bottom"
                              Margin="8,0,16,10" />
                    <CheckBox x:Name="InactiveBox" Grid.Column="2" Content="Incluir inactivos" VerticalAlignment="Bottom"
                              Margin="0,0,16,10" />
                    <Button Grid.Column="3" Content="Filtrar" Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Bottom" Margin="0,0,8,0" Click="Filter_Click" />
                    <Button Grid.Column="4" Content="Limpiar" Style="{StaticResource GhostButton}"
                            VerticalAlignment="Bottom" Click="Clear_Click" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <DataGrid x:Name="ProductsGrid" Height="430" RowHeight="52" ColumnHeaderHeight="36"
                                  MouseDoubleClick="ProductsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Producto" Width="1.5*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Unit}" FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="SKU" Width="78" Binding="{Binding Sku}" />
                                <DataGridTextColumn Header="Stock" Width="84" Binding="{Binding StockLabel}" />
                                <DataGridTemplateColumn Header="Mínimo" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MinStock, StringFormat={}{0:#,0.###}}"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Costo" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CostCents, Converter={StaticResource Money}}"
                                                       HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Precio" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PriceCents, Converter={StaticResource Money}}"
                                                       HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Valor" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InventoryValueCents, Converter={StaticResource Money}}"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Estado" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="statusPill" CornerRadius="99" Padding="9,3"
                                                    Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Left">
                                                <TextBlock x:Name="statusText" Text="{Binding InventoryStatus}"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding InventoryStatus}" Value="Inactivo">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource ElevatedBrush}" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InventoryStatus}" Value="Sin stock">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource ElevatedBrush}" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource MutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InventoryStatus}" Value="Agotado">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource DangerSoftBrush}" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InventoryStatus}" Value="Bajo stock">
                                                    <Setter TargetName="statusPill" Property="Background"
                                                            Value="{StaticResource WarnSoftBrush}" />
                                                    <Setter TargetName="statusText" Property="Foreground"
                                                            Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="62">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Ver" Style="{StaticResource SmallButton}" Width="54"
                                                    Tag="{Binding}" Click="Open_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="WriteActionsColumn" Header="" Width="172">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Editar" Style="{StaticResource RowActionButton}"
                                                        Width="58" Tag="{Binding}" Click="Edit_Click" Margin="0,0,4,0" />
                                                <Button x:Name="toggleButton" Content="Desactivar"
                                                        Style="{StaticResource RowActionButton}" Width="86"
                                                        Tag="{Binding}" Click="Toggle_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Margin="0,52,0,56">
                            <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE719;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Sin productos" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                            <TextBlock Text="Agrega tus productos o servicios para controlar stock, costos y facturación."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <Button x:Name="EmptyNewButton" Content="Nuevo producto" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Margin="0,14,0,0" Click="New_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                            Padding="16,11">
                        <Grid>
                            <TextBlock x:Name="CountText" Text="0 productos" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="UnitCountText" HorizontalAlignment="Right"
                                       Style="{StaticResource MutedText}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


