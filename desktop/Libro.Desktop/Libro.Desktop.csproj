<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- Piso de sistema operativo: Windows 10 1809+ y Windows 11.
         Se garantiza en tres capas: el runtime .NET 8 (requiere Windows 10+),
         el manifiesto (supportedOS Windows 10/11) y MinVersion del instalador.
         No se usa SupportedOSPlatformVersion porque net8.0-windows fija
         TargetPlatformVersion 7.0; subirlo exigiría net8.0-windows10.x y
         arrastraría el paquete de proyecciones WinRT sin uso en esta app. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Libro</AssemblyName>
    <ApplicationIcon>..\..\installer\libro.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <FileVersion>2.1.0.0</FileVersion>
    <Product>Libro · Contabilidad</Product>
    <Company>Libro</Company>
    <Description>Sistema de contabilidad local para negocios en México</Description>
    <Copyright>© 2026 Libro</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.21" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
