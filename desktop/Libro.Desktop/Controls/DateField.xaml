<UserControl x:Class="Libro.Desktop.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="38">
    <Grid>
        <Border x:Name="FieldBorder" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DateText" Background="Transparent" BorderThickness="0" Height="Auto"
                         Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                         GotFocus="DateText_GotFocus" LostFocus="DateText_LostFocus"
                         KeyDown="DateText_KeyDown" />
                <Button x:Name="CalendarButton" Grid.Column="1" Style="{StaticResource IconButton}"
                        Content="&#xE787;" Width="32" Height="30" FontSize="13"
                        Foreground="{StaticResource MutedBrush}" ToolTip="Elegir fecha"
                        Click="CalendarButton_Click" />
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=FieldBorder}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" />
                </Border.Effect>
                <Calendar x:Name="CalendarDisplay" SelectedDatesChanged="CalendarDisplay_SelectedDatesChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
