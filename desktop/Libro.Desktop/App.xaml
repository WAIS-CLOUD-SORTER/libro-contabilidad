<Application x:Class="Libro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Libro.Desktop"
             xmlns:conv="clr-namespace:Libro.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:MoneyConverter x:Key="Money" />
            <conv:DateConverter x:Key="Date" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:StatusLabelConverter x:Key="StatusLabel" />
            <conv:TypeToBrushConverter x:Key="TypeBrush" />
            <conv:StatusToBrushConverter x:Key="StatusBrush" />
            <conv:ManualVisibilityConverter x:Key="ManualVisibility" />
            <conv:AutomaticVisibilityConverter x:Key="AutomaticVisibility" />
            <conv:SourceLabelConverter x:Key="SourceLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
